# APEX runs with none of these set — it falls back to an in-process reasoning core and
# the browser's own speech synthesis. Fill them in to bring the real stack online.

# Reasoning. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Voice output. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional. Defaults to a dry, level system voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Optional. A Conversational AI (Agents Platform) agent for a second, full-duplex voice
# surface — not used by the chat pipeline above. See docs/agent-system/PLAN.md.
ELEVENLABS_AGENT_ID=

# Life Dashboard / Second Brain / Executive Assistant. A self-hosted Hermes Agent
# (https://github.com/NousResearch/hermes-agent) instance holding the Calendar, Gmail,
# and Obsidian-vault integrations. See docs/agent-system/PLAN.md for why this is one
# bridge instead of four integrations in this repo.
HERMES_GATEWAY_URL=
HERMES_API_KEY=
# The agent's own inbox, wired up as a Hermes messaging-gateway channel — not read here.
HERMES_AGENT_EMAIL=
