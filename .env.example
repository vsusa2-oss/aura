# APEX runs with none of these set — it falls back to an in-process reasoning core and
# the browser's own speech synthesis. Fill them in to bring the real stack online.

# Reasoning. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Voice output. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional. Defaults to a dry, level system voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
